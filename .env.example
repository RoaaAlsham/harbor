HARBOR_PORT=8788

# API — verifies inbound AuthDeep gateway signatures (see AUTHDEEP_INTEGRATION.md).
# Never commit real values.
AUTHDEEP_GATEWAY_KEY=
AUTHDEEP_SERVICE_SECRET=

# Worker — calls AuthDeep (product reads via the harbor-api gateway proxy,
# digest emails via the notifications route). Same sak_ for both.
AUTHDEEP_BASE_URL=
AUTHDEEP_SERVICE_KEY=
AUTHDEEP_HMAC_SECRET=
AUTHDEEP_DIGEST_TO=
